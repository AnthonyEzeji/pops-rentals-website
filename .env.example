# Copy to .env and fill in. See docs/DEPLOY.md for what each value does.

# --- Database (docker compose up -d gives you this locally) ---
DATABASE_URL="postgresql://fleet:fleet@localhost:55432/fleet_reserve"
DIRECT_URL="postgresql://fleet:fleet@localhost:55432/fleet_reserve"

# --- Admin sessions: 32+ random chars in production ---
SESSION_SECRET="dev-only-change-me-before-deploying-anywhere"

# --- Where the business operates. TZ must match BUSINESS_TIMEZONE on Vercel. ---
BUSINESS_TIMEZONE="America/New_York"
APP_URL="http://localhost:3000"

# --- Branding and contact details shown on the site ---
NEXT_PUBLIC_BUSINESS_NAME="Pops Rentals"
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_BUSINESS_EMAIL=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_INSTAGRAM="@popsrentals_"

# --- Business rules (defaults in src/lib/config.ts) ---
# SELF_DRIVE_DEPOSIT_PERCENT=25
# MIN_RENTAL_DAYS=1
# BOOKING_BUFFER_MINUTES=120
# CANCELLATION_WINDOW_HOURS=48
# WEEKLY_DISCOUNT_PERCENT=15
# MONTHLY_DISCOUNT_PERCENT=25
# CHAUFFEUR_HOLDS_ON_REQUEST=false

# --- Payments (optional; without a key bookings are pay-at-pickup) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email via Resend (optional; without a key emails print to the console) ---
RESEND_API_KEY=""
EMAIL_FROM="Pops Rentals <bookings@yourdomain.com>"
# Where new-booking alerts are emailed.
ADMIN_NOTIFICATION_EMAIL=""

# --- Owner SMS via Twilio (optional; without credentials texts print to the console) ---
# All three are required for sending. Numbers in E.164 form, e.g. +12125551234.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# The owner's mobile(s), comma-separated. Bare 10-digit numbers are treated as US.
# Texted on every new booking/request and on each paid deposit.
ADMIN_NOTIFICATION_PHONE=""

# --- Vehicle photo uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""
